SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=write_products

# Existing Node.js rendering service. Do not expose this token to browser code.
RENDERING_API_URL=https://rendering-api.example.com
RENDERING_API_TOKEN=

# Non-secret storage allowlist. Defaults retain existing production behavior.
APP_ENV=production
RENDERING_STORAGE_ORIGIN=https://uploads.blob.core.windows.net
RENDERING_STORAGE_CONTAINER=renderes
RENDERING_CSV_SUBMISSION_ENABLED=false
# Required only for APP_ENV=staging; comma-separated canonical test-shop domains.
STAGING_ALLOWED_SHOPS=

# Keep false until API 1.4 deployment, migration 008 and private test storage are verified.
# Uses the existing API and account with the separate renderes-test container.
RENDERING_TEST_MODE_ENABLED=false
